# VaaniBook Local/Server Environment Configuration
# Ports (Configured to avoid conflicts with existing projects on 3000/3001 & 8000/8001)
FRONTEND_PORT=3002
BACKEND_PORT=8002

# Public API URL used by the frontend to contact the FastAPI backend
# For local development:
NEXT_PUBLIC_API_URL=http://localhost:8000
# For local Docker Compose testing:
# NEXT_PUBLIC_API_URL=http://localhost:8002
# For Vercel deployment (set in Vercel project environment settings):
# NEXT_PUBLIC_API_URL=https://your-backend-app.onrender.com

