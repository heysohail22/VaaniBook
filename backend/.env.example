# Sarvam AI API Credentials
# Your API key (supports both SARVAM_API_KEY and servam_api_key)
SARVAM_API_KEY=your_sarvam_api_key_here

# Sarvam Voice Agent Identifiers (from dashboard URL or settings)
SARVAM_ORG_ID=your_org_id_here
SARVAM_WORKSPACE_ID=your_workspace_id_here

# The Voice Agent App ID created in Sarvam dashboard
SARVAM_APP_ID=your_agent_app_id_here
SARVAM_APP_VERSION=1

# Telephony connection from the rented number (Deploy -> Phone Numbers)
SARVAM_CONNECTION_ID=your_connection_id_here
SARVAM_AGENT_PHONE=+91XXXXXXXXXX

# Frontend URL for CORS (change to your Vercel URL when deploying on Render)
FRONTEND_URL=http://localhost:3000

